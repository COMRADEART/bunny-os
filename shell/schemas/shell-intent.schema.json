{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/shell/intent-1.schema.json",
  "title": "Bunny Shell typed intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "confidence", "payload", "requiresConfirmation", "requiresBunnyPermission", "requiresBrokerPermission"],
  "properties": {
    "type": {"enum": ["launch_application", "open_file", "open_folder", "open_workspace", "bunny_request", "system_action", "open_setting", "search"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "payload": {"type": "object", "maxProperties": 12},
    "requiresConfirmation": {"type": "boolean"},
    "requiresBunnyPermission": {"type": "boolean"},
    "requiresBrokerPermission": {"type": "boolean"}
  }
}
