<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="bunny-desktop-v2">
  <schema id="org.bunnyos.desktop.visual-v2" path="/org/bunnyos/desktop/visual-v2/">
    <key name="visual-mode" type="s">
      <choices><choice value="regular"/><choice value="character"/></choices>
      <default>'regular'</default>
      <summary>Runtime Bunny visual assistance mode</summary>
    </key>
    <key name="color-scheme" type="s">
      <choices><choice value="system"/><choice value="dark"/><choice value="light"/></choices>
      <default>'system'</default>
      <summary>Semantic Bunny surface color scheme</summary>
    </key>
    <key name="accent-color" type="s">
      <choices><choice value="violet"/><choice value="sky"/><choice value="indigo"/></choices>
      <default>'violet'</default>
      <summary>Bunny interface accent</summary>
    </key>
    <key name="layout-mode" type="s">
      <choices><choice value="normal"/><choice value="compact"/><choice value="focus"/></choices>
      <default>'normal'</default>
      <summary>Bunny desktop layout mode</summary>
    </key>
    <key name="character-enabled" type="b">
      <default>false</default>
      <summary>Allow the guide in approved surfaces while Character Mode is selected</summary>
    </key>
    <key name="character-scale" type="d">
      <range min="0.80" max="1.20"/>
      <default>1.0</default>
      <summary>Guide illustration scale inside its bounded region</summary>
    </key>
    <key name="character-position" type="s">
      <choices><choice value="automatic"/><choice value="left"/><choice value="right"/></choices>
      <default>'automatic'</default>
      <summary>Preferred guide position inside an approved surface</summary>
    </key>
    <key name="character-reduced-motion" type="b">
      <default>false</default>
      <summary>Suppress character-specific entrance motion</summary>
    </key>
    <key name="character-educational-appearances" type="b">
      <default>true</default>
      <summary>Show the guide for approved educational explanations</summary>
    </key>
    <key name="character-success-appearances" type="b">
      <default>true</default>
      <summary>Show the guide after an observed successful result</summary>
    </key>
    <key name="character-error-appearances" type="b">
      <default>true</default>
      <summary>Show the guide for confirmed error and offline guidance</summary>
    </key>
    <key name="character-onboarding-appearances" type="b">
      <default>true</default>
      <summary>Show the guide in approved onboarding steps</summary>
    </key>
    <key name="reduced-motion" type="b">
      <default>false</default>
      <summary>Remove nonessential motion</summary>
    </key>
    <key name="panel-transparency" type="d">
      <range min="0.72" max="1.0"/>
      <default>0.92</default>
      <summary>Opacity of Bunny panels</summary>
    </key>
    <key name="dock-autohide" type="b">
      <default>true</default>
      <summary>Auto-hide the adaptive dock when appropriate</summary>
    </key>
    <key name="assistant-panel-width" type="i">
      <range min="320" max="480"/>
      <default>400</default>
      <summary>Preferred assistant panel width in logical pixels</summary>
    </key>
    <key name="command-palette-shortcut" type="as">
      <default><![CDATA[['<Super>space']]]></default>
      <summary>Open the Bunny Command Palette</summary>
    </key>
    <key name="open-assistant" type="as">
      <default><![CDATA[['<Super><Shift>b']]]></default>
      <summary>Open the Bunny Assistant panel</summary>
    </key>
    <key name="open-approvals" type="as">
      <default><![CDATA[['<Super><Shift>a']]]></default>
      <summary>Open the Approval Center</summary>
    </key>
    <key name="toggle-visual-mode" type="as">
      <default><![CDATA[['<Super><Alt>b']]]></default>
      <summary>Switch between Regular and Character modes</summary>
    </key>
    <key name="focus-mode-enabled" type="b">
      <default>false</default>
      <summary>Enable FocusMode</summary>
    </key>
    <key name="compact-layout-enabled" type="b">
      <default>false</default>
      <summary>Enable Compact layout</summary>
    </key>
    <key name="high-contrast" type="b">
      <default>false</default>
      <summary>Use the high-contrast Bunny presentation</summary>
    </key>
  </schema>
</schemalist>
