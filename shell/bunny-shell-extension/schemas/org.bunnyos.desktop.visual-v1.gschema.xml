<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="bunny-desktop-v1">
  <schema id="org.bunnyos.desktop.visual-v1" path="/org/bunnyos/desktop/visual-v1/">
    <key name="open-command-palette" type="as">
      <default><![CDATA[['<Super>space']]]></default>
      <summary>Open the Bunny Command Palette</summary>
    </key>
    <key name="open-assistant" type="as">
      <default><![CDATA[['<Super><Shift>b']]]></default>
      <summary>Open the Bunny Assistant panel</summary>
    </key>
    <key name="open-approvals" type="as">
      <default><![CDATA[['<Super><Shift>a']]]></default>
      <summary>Open the Approval Center panel</summary>
    </key>
    <key name="layout-mode" type="s">
      <choices>
        <choice value="normal"/>
        <choice value="compact"/>
        <choice value="focus"/>
      </choices>
      <default>'normal'</default>
      <summary>Active Bunny layout mode</summary>
    </key>
    <key name="theme" type="s">
      <choices>
        <choice value="system"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'system'</default>
      <summary>Bunny surface theme</summary>
    </key>
    <key name="dock-auto-hide" type="b">
      <default>true</default>
      <summary>Hide the dock behind maximized windows</summary>
    </key>
    <key name="reduced-motion" type="b">
      <default>false</default>
      <summary>Disable nonessential Bunny surface motion</summary>
    </key>
    <key name="high-contrast" type="b">
      <default>false</default>
      <summary>Use high-contrast Bunny presentation</summary>
    </key>
  </schema>
</schemalist>
