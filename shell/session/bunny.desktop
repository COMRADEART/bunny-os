[Desktop Entry]
Name=Bunny
Comment=Bunny Shell on Hyprland — the desktop customization compositor
Exec=/usr/libexec/bunny-hyprland-session
TryExec=/usr/libexec/bunny-hyprland-session
Type=Application
DesktopNames=Bunny;Hyprland;
# X-GDM-SessionRegisters is deliberately absent. Hyprland does not register a
# GNOME-style session with GDM; with the flag set GDM waited for a registration
# that never came (measured on the GNOME wrapper path; keep the same rule here).
