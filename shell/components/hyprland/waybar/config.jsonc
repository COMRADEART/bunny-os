{
  "layer": "top",
  "position": "top",
  "height": 36,
  "modules-left": ["hyprland/workspaces", "custom/bunny-layout", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray"],
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "custom/bunny-layout": {
    "exec": "bunny-adaptive-layout waybar",
    "return-type": "json",
    "interval": 2,
    "on-click": "bunny-adaptive-layout cycle --apply",
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "muted"
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "wired",
    "format-disconnected": "offline"
  },
  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}%+"
  }
}
