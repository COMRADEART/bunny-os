#!/usr/bin/python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

installed = Path("/usr/lib/bunny-os/python")
sys.path.insert(0, str(installed if installed.is_dir() else Path(__file__).resolve().parents[1]))

from bunny_os.info import human, inventory

parser = argparse.ArgumentParser(prog="bunny-os-info")
parser.add_argument("--json", action="store_true")
args = parser.parse_args()
value = inventory()
print(json.dumps(value, indent=2, sort_keys=True) if args.json else human(value))
