"""The Bunny setup surface. Autostarted in the live session."""
import sys
from pathlib import Path

installed = Path("/usr/lib/bunny-installer")
sys.path.insert(0, str(installed if installed.is_dir() else Path(__file__).resolve().parents[2]))

from installer.frontend.setup import run

if __name__ == "__main__":
    raise SystemExit(run())
