{
  "$comment": "SPDX-FileCopyrightText: 2026 ComradeArt / SPDX-License-Identifier: GPL-3.0-or-later",
  "name": "tpm-absent",
  "title": "Boot with no TPM: the fallback must be predictable",
  "description": "Identical to first-boot except that the absence of a TPM is the point: the system must boot cleanly, no unit may fail for want of one, and nothing may hang waiting for a device that is not there.",
  "scenarioVersion": "isq-1",
  "environment": "qemu-kvm",
  "disk": {"sizeGiB": 64, "blank": false, "preExistingData": false},
  "resources": {"vcpus": 4, "memoryMiB": 8192},
  "firmware": "uefi",
  "tpm": "none",
  "network": "enabled",
  "timeoutSeconds": 900,
  "markers": [
    {"label": "boot-target", "regex": "Reached target .*(Multi-User System|Graphical Interface)", "required": true},
    {"label": "health-check", "regex": "Finished .*Bunny OS boot health check", "required": true}
  ],
  "forbiddenMarkers": [
    {"label": "tpm-wait", "regex": "(Timed out waiting for device.*tpm|dependency failed.*tpm)"}
  ],
  "expectedOutcome": "PASS",
  "destructive": false
}
