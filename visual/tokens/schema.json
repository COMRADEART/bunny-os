{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/visual-token-file.schema.json",
  "title": "Bunny visual token file",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "family", "version", "tokens"],
  "properties": {
    "$schema": {"type": "string"},
    "family": {
      "enum": ["colors", "typography", "spacing", "radius", "motion", "elevation"]
    },
    "version": {"type": "integer", "const": 1},
    "description": {"type": "string"},
    "tokens": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/token"}
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "type"],
      "properties": {
        "value": {},
        "type": {
          "enum": ["color", "dimension", "duration", "fontFamily", "fontWeight", "number", "shadow"]
        },
        "description": {"type": "string"},
        "reducedValue": {}
      }
    }
  }
}
