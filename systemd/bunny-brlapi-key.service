[Unit]
Description=Generate the per-device BrlAPI authorisation key
Documentation=file:///usr/share/doc/bunny-os/IMAGE_FINALISATION.md
# The key must exist before brltty starts, or the braille display is
# unauthorised for the whole session. Ordering is Before=brltty rather than a
# generic first-boot target because accessibility must not wait behind anything
# it does not have to.
After=local-fs.target systemd-tmpfiles-setup.service
Before=brltty.service brltty-udev.service basic.target
DefaultDependencies=no
# /etc must be writable before this runs, and RequiresMountsFor says so
# rather than leaving it to be implied by local-fs.target. On an ostree
# system /etc is composed at boot; ordering after the mount that provides it
# is the difference between writing the key and failing to.
RequiresMountsFor=/etc
#
# There is deliberately no ConditionPathExists here.
#
# The unit used to carry ConditionPathExists=!/etc/brlapi.key, which reads as
# "only run when the key is missing" and is the obvious way to avoid
# rotating a key every boot. It also made the generator's recovery policy
# unreachable: an empty or malformed key is a file that exists, so systemd
# skipped the unit, and the one case where a braille user most needs the key
# rebuilt was the one case nothing would rebuild it.
#
# Deciding is the generator's job and it already does it — a well-formed key
# is left strictly alone, anything else is replaced and the replacement is
# announced. Running unconditionally costs a stat on every boot and makes
# recovery automatic instead of requiring a recovery console.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bunny-brlapi-key
User=root
Group=root
NoNewPrivileges=yes
# CHOWN is required to hand the key to the brlapi group, and nothing else is.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc
RestrictAddressFamilies=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
TimeoutStartSec=30s
StandardOutput=journal
# The generator never prints the key. StandardError carries only the
# group-missing warning, and a secret in a journal is a secret in every support
# bundle downstream of it.
StandardError=journal

[Install]
WantedBy=sysinit.target
