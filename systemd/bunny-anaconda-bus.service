[Unit]
# Anaconda's DBus module layer, started for the Bunny installer backend.
#
# The medium boots Bunny's own setup surface instead of anaconda, and the
# backend's executor drives Anaconda's Boss over the private bus anaconda
# would normally start for itself. Run 11 of Journey A found that nothing
# started it: the executor's preflight read /run/anaconda/bus.address on a
# medium where no process had ever written it, and every confirmed
# installation ended at "destructive executor is unavailable".
#
# dbus-daemon runs anaconda's own bus configuration, whose servicedir makes
# the Boss and its modules DBus-activatable on first call — measured inside
# the live image before this unit existed: starting exactly this daemon and
# introspecting the Boss passes the executor's preflight.
Description=Anaconda private DBus for the Bunny installer backend
ConditionPathExists=/run/bunny-installer/live-session
Requires=bunny-live-session.service
After=bunny-live-session.service
Before=bunny-installer-backend.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
RuntimeDirectory=anaconda
ExecStart=/usr/bin/bash -c 'exec /usr/bin/dbus-daemon --config-file=/usr/share/anaconda/dbus/anaconda-bus.conf --nofork --print-address=3 3>/run/anaconda/bus.address'
# "Started" must mean "the address is readable": the backend preflights its
# executor the moment it starts, and ordering alone would race the write.
ExecStartPost=/usr/bin/bash -c 'for _ in $(seq 100); do [ -s /run/anaconda/bus.address ] && exit 0; sleep 0.1; done; echo "the bus address was never written" >&2; exit 1'
Restart=no

[Install]
WantedBy=graphical.target
