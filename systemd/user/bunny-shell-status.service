[Unit]
Description=Bunny Shell bounded status projection
Documentation=file:///usr/share/doc/bunny-os/BUNNY_SHELL.md
PartOf=bunny-shell.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/bunny-shell-service
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=4
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=bunny-shell
StateDirectory=bunny-shell
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=96M
TasksMax=64
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
