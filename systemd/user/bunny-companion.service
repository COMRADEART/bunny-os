[Unit]
# The long-lived half of the companion. It owns the sessions, the tasks and the
# event stream; the window is a client of it and closing the window must not
# stop a task. That is why this is a service at all rather than something the
# GTK application starts for itself.
Description=Bunny Companion runtime
Documentation=file:///usr/share/doc/bunny-os/COMPANION_INTEGRATION.md
PartOf=graphical-session.target
# After the target, not after graphical-session-pre.target. Ordering only after
# `-pre` starts this service *while* the session is coming up: measured on a
# booted system, it started at 14:00:23 and graphical-session.target was reached
# at 14:00:25, two seconds after — and gnome-session imports WAYLAND_DISPLAY and
# DISPLAY into the user manager somewhere in that gap. The service therefore had
# XDG_SESSION_TYPE=wayland and no display variable at all, and every desktop
# adapter refused for the life of the session with "there is no graphical
# session". A spoken "Open Files" was approved and then answered with that
# sentence on a machine with a desktop on screen.
#
# The service also adopts the display from the runtime directory if it is still
# missing, because ordering is a promise about start time and that is a fact
# about the machine; see companion.desktop.environment.
After=graphical-session.target
# The companion imports the capability runtime to decide where a task may run.
# Without it there is no capability authority and the service must not start and
# improvise one; the condition names the missing dependency in the journal
# rather than producing an ImportError on every restart attempt.
ConditionPathExists=/usr/lib/bunny-os/python/capability
StartLimitIntervalSec=60s
StartLimitBurst=4

[Service]
Type=simple
ExecStart=/usr/libexec/bunny-companion-service
# Bounded, not unlimited. A runtime that respawned for ever would hide a store
# it cannot read behind a restart loop; four attempts in a minute and then a
# failed unit is a state somebody notices.
Restart=on-failure
RestartSec=3s
# Long enough for an append under the session lock to finish. A companion killed
# mid-append leaves an incomplete final record, which the store is built to
# survive — but surviving it is the fallback, not the plan.
TimeoutStopSec=15s

# The socket lives here, 0700, and goes away with the session.
RuntimeDirectory=bunny-companion
RuntimeDirectoryMode=0700
# The store lives here. Per-user under the session, never system-wide: a
# companion session is one person's conversation and /var would make it readable
# by every account on a shared machine.
StateDirectory=bunny-companion
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX only. The companion has no remote provider, makes no outbound
# connection and needs no address family that could carry one — so the kernel
# is told, and a provider adapter added later has to change this file, in a
# review, rather than simply starting to work.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Deliberately absent: Pocket's CPU-only PyTorch/oneDNN kernels may create
# executable code pages just as Mesa does in the separate window unit. Enabling
# systemd's write/execute denial makes the kernel kill valid local inference. The
# process remains offline (AF_UNIX only), unprivileged, read-only outside its
# private state, syscall-filtered and bounded by MemoryHigh/MemoryMax below.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The smallest validated Vosk model brings the companion process to roughly
# 175 MiB while recognition is active. Pocket TTS adds a persistent, isolated
# CPU-only PyTorch worker with a 1 GiB conservative provider estimate. These
# are enforcement budgets, not benchmark claims: MemoryHigh asks the kernel to
# reclaim before the hard limit, while MemoryMax still contains a runaway
# worker. Low-resource mode starts at the much smaller Kitten provider. The
# graphical window remains a separate process and cgroup.
MemoryHigh=1536M
MemoryMax=2G
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
