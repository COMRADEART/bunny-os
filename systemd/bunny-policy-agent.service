[Unit]
Description=Bunny OS device policy agent
Documentation=file:///usr/share/doc/bunny-os/DEVICE_POLICY.md
After=network-online.target bunny-system-broker.socket
Wants=network-online.target
ConditionPathExists=/etc/bunny-os/enrolment.json

[Service]
Type=oneshot
User=bunny-policy
Group=bunny-policy
ExecStart=/usr/libexec/bunny-policy-agent
# The agent verifies a signed bundle, stages it, then asks the broker to apply
# it. It never writes /etc/bunny-os/managed-settings.json itself: that file is
# root-owned and only the broker may write it.
StateDirectory=bunny-os/policy
StateDirectoryMode=0700
ReadWritePaths=/var/lib/bunny-os/policy
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
