{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/visual-v2-token.json",
  "title": "Bunny Desktop Visual V2 token file",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 2},
    "themes": {"type": "object"},
    "accents": {"type": "object"},
    "semantic": {"type": "object"},
    "families": {"type": "object"},
    "scale": {"type": "object"},
    "baseGrid": {"type": "integer"},
    "tokens": {"type": "object"},
    "reducedMotionRemoves": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
