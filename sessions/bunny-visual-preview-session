"""Start the isolated Bunny Desktop Visual V1 preview session."""

from __future__ import annotations

import os


def main() -> int:
    # The session mode owns extension selection. No per-user dconf preference is
    # changed here, so selecting GNOME later restores the ordinary GNOME surface.
    os.environ["BUNNY_VISUAL_PREVIEW"] = "1"
    os.environ["XDG_CURRENT_DESKTOP"] = "BunnyVisualPreview:GNOME"
    os.environ["DESKTOP_SESSION"] = "bunny-visual-preview"
    os.execv(
        "/usr/bin/gnome-session",
        ["/usr/bin/gnome-session", "--session=bunny-visual-preview"],
    )
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
