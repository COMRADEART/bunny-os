#!/bin/sh
# Bunny Shell Experimental session launcher.
#
# BUNNY WAYLAND SHELL EXPERIMENT
# NOT RELEASE QUALIFIED
# DO NOT USE AS THE DEFAULT SESSION
#
# This launcher fails closed. It refuses to start unless the operator has opted
# in explicitly, and it refuses to start if GNOME has stopped being available as
# the supported fallback session.
set -eu

banner() {
    printf '%s\n' 'BUNNY WAYLAND SHELL EXPERIMENT' >&2
    printf '%s\n' 'NOT RELEASE QUALIFIED' >&2
    printf '%s\n' 'DO NOT USE AS THE DEFAULT SESSION' >&2
}

refuse() {
    printf 'bunny-shell-experimental-session: %s\n' "$1" >&2
    exit 2
}

banner

# 1. Explicit experimental opt-in. Selecting the session at the login screen is
#    not sufficient on its own; the operator must have set the variable.
if [ "${BUNNY_SHELL_EXPERIMENTAL:-}" != "1" ]; then
    refuse 'refusing to start: set BUNNY_SHELL_EXPERIMENTAL=1 to run the experimental shell'
fi

# 2. GNOME must remain installed and selectable. If the supported fallback
#    session has gone missing, the experimental shell is the only session left
#    and must not run.
gnome_session_present=0
for dir in /usr/share/wayland-sessions /usr/share/xsessions; do
    if [ -f "$dir/gnome.desktop" ] || [ -f "$dir/gnome-wayland.desktop" ] || [ -f "$dir/gnome-xorg.desktop" ]; then
        gnome_session_present=1
    fi
done
if [ "$gnome_session_present" != "1" ] && [ "${BUNNY_SHELL_ALLOW_MISSING_GNOME:-}" != "1" ]; then
    refuse 'refusing to start: GNOME is not installed as a selectable session; GNOME must remain the supported fallback'
fi

# 3. The experimental shell must never be anybody's default session.
if [ "${BUNNY_SHELL_IS_DEFAULT_SESSION:-}" = "1" ]; then
    refuse 'refusing to start: the experimental shell must not be configured as the default session'
fi

# 4. Never run inside a qualification run.
if [ -n "${BUNNY_QUALIFICATION_RUN:-}" ]; then
    refuse 'refusing to start: a qualification run is in progress'
fi

# --check is used by the session manager to test runnability without starting
# anything. Everything above has already passed at this point.
if [ "${1:-}" = "--check" ]; then
    printf '%s\n' 'bunny-shell-experimental-session: runnable' >&2
    exit 0
fi

if [ "${XDG_SESSION_TYPE:-}" != "wayland" ] && [ "${BUNNY_SHELL_NESTED:-}" != "1" ]; then
    refuse 'requires a Wayland session, or BUNNY_SHELL_NESTED=1 for a nested developer run'
fi

BUNNY_SHELL_SESSION_KIND=${BUNNY_SHELL_SESSION_KIND:-experimental}
export BUNNY_SHELL_SESSION_KIND
export XDG_CURRENT_DESKTOP=BunnyShellExperimental
export XDG_SESSION_DESKTOP=bunny-shell-experimental

supervisor=/usr/libexec/bunny-shell-supervisor
if [ ! -x "$supervisor" ]; then
    # Developer tree layout, used by `make bunny-shell-run-nested`.
    supervisor=$(dirname "$0")/bunny-shell-supervisor
fi
[ -x "$supervisor" ] || refuse 'bunny-shell-supervisor is not installed'

exec "$supervisor" --session-file "$(dirname "$0")/bunny-shell-experimental.session"
