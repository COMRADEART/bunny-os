#!/usr/bin/env python3
"""Session supervisor for the experimental Bunny Wayland shell.

BUNNY WAYLAND SHELL EXPERIMENT — NOT RELEASE QUALIFIED — DO NOT USE AS THE
DEFAULT SESSION.

The restart policy lives in bunny_shell_v3.supervisor so it can be tested
without starting a compositor. This entry point resolves paths, runs the start
gates and hands over.
"""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import sys


def _import_library():
    source = Path(__file__).resolve().parents[1] / "apps/common"
    installed = Path("/usr/lib/bunny-shell-v3")
    sys.path.insert(0, str(source if source.is_dir() else installed))
    from bunny_shell_v3 import session, supervisor  # noqa: E402

    return session, supervisor


def resolve_compositor(explicit: str | None) -> str | None:
    if explicit:
        return explicit
    if os.environ.get("BUNNY_SHELL_BINARY"):
        return os.environ["BUNNY_SHELL_BINARY"]
    found = shutil.which("bunny-shell")
    if found:
        return found
    # Developer tree, after `make bunny-shell-build`.
    root = Path(__file__).resolve().parents[1]
    for candidate in (
        root / "compositor/bunny-shell/target/release/bunny-shell",
        root / "compositor/bunny-shell/target/debug/bunny-shell",
    ):
        if candidate.is_file():
            return str(candidate)
    return None


def state_directory() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(base) / "bunny-shell"


def main() -> int:
    session, supervisor_module = _import_library()

    parser = argparse.ArgumentParser(description="Bunny experimental shell session supervisor")
    parser.add_argument("--session-file", type=Path, default=None)
    parser.add_argument("--compositor", default=None)
    parser.add_argument("--state-dir", type=Path, default=None)
    parser.add_argument("--max-restarts", type=int, default=1)
    parser.add_argument("--max-total-restarts", type=int, default=3)
    parser.add_argument(
        "--recovery",
        action="store_true",
        help="print the recovery guidance and exit; used by bunny-shell-recovery.service",
    )
    parser.add_argument("compositor_arguments", nargs="*", default=[])
    arguments = parser.parse_args()

    for line in supervisor_module.NOTICE.splitlines():
        print(line, file=sys.stderr)

    state_dir = arguments.state_dir or state_directory()

    if arguments.recovery:
        supervisor_module.print_recovery_guidance(
            "the experimental shell exhausted its restart budget"
        )
        return 0

    try:
        session.authorise(dict(os.environ), session.default_session_search_paths())
    except session.SessionRefusal as refusal:
        print(f"bunny-shell-supervisor: {refusal}", file=sys.stderr)
        return 2

    compositor = resolve_compositor(arguments.compositor)
    if not compositor:
        print(
            "bunny-shell-supervisor: no bunny-shell binary found; run `make bunny-shell-build`",
            file=sys.stderr,
        )
        return 2

    if arguments.session_file and arguments.session_file.is_file():
        values = session.parse_session_file(arguments.session_file.read_text(encoding="utf-8"))
        required = session.components(values, "RequiredComponents")
        print(f"bunny-shell-supervisor: required components {required}", file=sys.stderr)

    policy = supervisor_module.RestartPolicy(
        max_consecutive_restarts=max(0, arguments.max_restarts),
        max_total_restarts=max(0, arguments.max_total_restarts),
    )
    runner = supervisor_module.Supervisor(
        command=[compositor, *arguments.compositor_arguments],
        state_dir=state_dir,
        policy=policy,
    )
    return runner.run()


if __name__ == "__main__":
    raise SystemExit(main())
