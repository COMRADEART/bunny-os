# syntax=docker/dockerfile:1
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44
FROM ${BASE_IMAGE}

ARG BUNNY_PROFILE=developer
ARG BUNNY_OS_VERSION=0.1.0
ARG BUNNY_IMAGE_VERSION=0.1.0-dev
ARG BUNNY_SOURCE_COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0
ARG BASE_IMAGE
ARG BUNNY_RELEASE_BUILD=0
# One of the two channels in docs/PUBLIC_ALPHA_SCOPE.md §40. It reaches
# release.json and /usr/lib/os-release, so an Alpha image says Alpha in every
# surface that names the system. Defaulted to development, because an
# unlabelled build is a development build and that is the label promising least.
ARG BUNNY_RELEASE_CHANNEL=development

LABEL org.opencontainers.image.title="Bunny OS" \
      org.opencontainers.image.version="${BUNNY_OS_VERSION}" \
      org.opencontainers.image.revision="${BUNNY_SOURCE_COMMIT}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      art.comrade.bunny-os.contract="1.0.0" \
      art.comrade.bunny-os.channel="${BUNNY_RELEASE_CHANNEL}" \
      containers.bootc="1"

COPY build /tmp/bunny-os/build
# assets, capability and companion reach the build context here.
#
# install-root.py copied capability/ and companion/ before these lines existed,
# and `Path.rglob` on a directory that is not in the context simply yields
# nothing — so the build succeeded and installed two *empty* package
# directories. The companion user unit's ConditionPathExists was satisfied by
# the empty directory, the service started, and it failed on import at every
# restart. A missing COPY is not a build error; it is a silently empty install.
COPY assets /tmp/bunny-os/assets
COPY capability /tmp/bunny-os/capability
COPY capsules /tmp/bunny-os/capsules
COPY catalog /tmp/bunny-os/catalog
COPY companion /tmp/bunny-os/companion
COPY config /tmp/bunny-os/config
COPY desktop-integration /tmp/bunny-os/desktop-integration
COPY docs /tmp/bunny-os/docs
COPY installer /tmp/bunny-os/installer
COPY ARCHITECTURE.md README.md /tmp/bunny-os/
COPY schemas /tmp/bunny-os/schemas
COPY scripts /tmp/bunny-os/scripts
COPY selinux /tmp/bunny-os/selinux
COPY services /tmp/bunny-os/services
COPY shell /tmp/bunny-os/shell
COPY systemd /tmp/bunny-os/systemd
COPY tools /tmp/bunny-os/tools
COPY trust /tmp/bunny-os/trust

# A hermetic build installs from the retained snapshot bind-mounted at
# /snapshot and stamps the transaction with the declared epoch through the
# bind-mounted libfaketime. Both are `podman build --volume` mounts: they exist
# for the RUN step and nothing they carry ends up in the image.
ARG BUNNY_SNAPSHOT_ROOT=
ARG BUNNY_FAKETIME_LIBRARY=
# The SQLite version the database finaliser must find in this container. The
# finalisation runs against this image's own sqlite — never the build host's —
# and that library is already pinned transitively, by the retained base digest
# and the package lock. This argument is the cross-check: it comes from the
# builder lock, so a base or snapshot change that moved SQLite fails the build
# with the two versions named instead of surfacing later as two databases that
# lay out identical rows differently.
ARG BUNNY_EXPECT_SQLITE=

RUN BUNNY_SNAPSHOT_ROOT="${BUNNY_SNAPSHOT_ROOT}" \
    BUNNY_FAKETIME_LIBRARY="${BUNNY_FAKETIME_LIBRARY}" \
    BUNNY_EXPECT_SQLITE="${BUNNY_EXPECT_SQLITE}" \
    SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH}" \
    /usr/bin/python3 /tmp/bunny-os/build/scripts/install-packages.py \
      --profile "${BUNNY_PROFILE}" \
      --release-build "${BUNNY_RELEASE_BUILD}" \
      --root /tmp/bunny-os/build/packages && \
    /usr/bin/python3 /tmp/bunny-os/build/scripts/install-root.py \
      --source /tmp/bunny-os \
      --profile "${BUNNY_PROFILE}" \
      --os-version "${BUNNY_OS_VERSION}" \
      --image-version "${BUNNY_IMAGE_VERSION}" \
      --source-commit "${BUNNY_SOURCE_COMMIT}" \
      --source-date-epoch "${SOURCE_DATE_EPOCH}" \
      --release-channel "${BUNNY_RELEASE_CHANNEL}" \
      --base-image "${BASE_IMAGE}" && \
    /usr/bin/dnf clean all && \
    /usr/bin/bash /tmp/bunny-os/build/scripts/finalise-image.sh \
      --epoch "${SOURCE_DATE_EPOCH}" \
      --report /usr/share/bunny-os/finalisation.json && \
    rm -rf /var/cache/dnf /tmp/bunny-os

# The installation medium's EFI boot files. Live profile only.
#
# Fedora 44 declares /boot/efi/EFI/fedora/{shimx64,shim,mmx64,gcdx64,grubx64}.efi
# and /boot/efi/EFI/BOOT/{BOOTX64.EFI,fbx64.efi} as %ghost — rpm owns the paths
# and never writes them. The real, signed binaries ship at
# /usr/lib/efi/shim/<version>/ and /usr/lib/efi/grub2/<version>/, and bootupd
# copies them onto the ESP at deployment. That is the whole of why
# `dnf reinstall shim-x64` repopulates nothing, and why the disk images are
# already correct: the raw and qcow2 artifacts carry a Fedora-signed ESP whose
# shimx64.efi is byte-identical to the rpm-owned original.
#
# osbuild's ISO stages did not follow that move. org.osbuild.grub2.iso and
# org.osbuild.bootiso.mono each read the *buildroot's* /boot/efi/EFI/<vendor>/
# with an absolute path, so `bootc-generic-iso` fails on any fedora-bootc image:
#   FileNotFoundError: /boot/efi/EFI/fedora/shimx64.efi
# Measured with image-builder 76.0.0 and osbuild 185. The mismatch is upstream;
# this is the smallest correction that does not reach outside the image.
#
# Every byte comes from the versioned, rpm-owned tree already inside this image
# — the same signed shim bootupd would install. Nothing is downloaded,
# substituted, re-signed or generated, so Secure Boot semantics are unchanged.
#
# Live profile only, and deliberately so: the payload image's ESP belongs to
# bootupd at deployment, and materialising these there would ship files that
# deployment shadows. It runs before the mtime pin below, so the copies are
# clamped to the epoch like everything else the build writes.
RUN bash -euo pipefail -c '\
    if [ "${BUNNY_PROFILE}" != "live" ]; then \
      echo "not the live profile; the ESP is bootupd'"'"'s to write at deployment"; \
      exit 0; \
    fi; \
    shim="$(dirname "$(find /usr/lib/efi/shim -name shimx64.efi | head -1)")"; \
    grub="$(dirname "$(find /usr/lib/efi/grub2 -name grubx64.efi | head -1)")"; \
    if [ -z "${shim}" ] || [ -z "${grub}" ]; then \
      echo "BLOCKED: shim-x64 and grub2-efi-x64(-cdboot) must be installed in the live profile;" >&2; \
      echo "without them there is no Fedora-signed binary to place and the ISO would boot nothing." >&2; \
      exit 2; \
    fi; \
    install -d /boot/efi/EFI/fedora /boot/efi/EFI/BOOT; \
    for name in shimx64.efi shim.efi mmx64.efi BOOTX64.CSV; do \
      install -m 0644 "${shim}/${name}" "/boot/efi/EFI/fedora/${name}"; \
    done; \
    for name in grubx64.efi gcdx64.efi; do \
      install -m 0644 "${grub}/${name}" "/boot/efi/EFI/fedora/${name}"; \
    done; \
    install -m 0644 "$(dirname "${shim}")/BOOT/BOOTX64.EFI" /boot/efi/EFI/BOOT/BOOTX64.EFI; \
    install -m 0644 "$(dirname "${shim}")/BOOT/fbx64.efi" /boot/efi/EFI/BOOT/fbx64.efi; \
    for name in shimx64.efi mmx64.efi gcdx64.efi; do \
      [ -s "/boot/efi/EFI/fedora/${name}" ] || { \
        echo "BLOCKED: /boot/efi/EFI/fedora/${name} is missing or empty after the copy" >&2; exit 2; }; \
    done; \
    cmp "${shim}/shimx64.efi" /boot/efi/EFI/fedora/shimx64.efi || { \
      echo "BLOCKED: the placed shim differs from the rpm-owned original" >&2; exit 2; }; \
    echo "placed Fedora shim ${shim} and grub ${grub} at /boot/efi/EFI"'

# Pin every mtime the build itself wrote, as the last thing that happens.
#
# It has to be a separate step and it has to be last, because the step above
# ends by deleting /tmp/bunny-os and that deletion updates /tmp's own mtime
# after finalisation has already run. Measured on two hermetic builds:
# usr/share/bunny-os/finalisation.json had identical content and mtimes of
# 1785439457 and 1785439660 — wall clock, 203 seconds apart. The dimension
# collector does not compare mtimes, so nothing reported it; the layer tar
# contains them, so ociLayers and rawArchive differed and the difference was
# attributed entirely to the two databases.
#
# `-newermt` selects exactly what this build wrote: anything RPM installed
# carries the mtime from its package, which is earlier than the epoch and is
# packaging information rather than build noise, so it is left alone. The
# assertion afterwards is what makes this a check rather than a sweep — if a
# path cannot be pinned, the build stops instead of shipping an artifact whose
# archive digest nobody can explain.
# Mount points are excluded, and *only* mount points.
#
# /snapshot is the retained package snapshot bind-mounted read-only for this
# build, and touching it fails outright:
#
#   touch: setting times of '/snapshot': Read-only file system
#
# It is also not in the committed layer, which is the actual reason — the same
# reason finalise-image.sh empties /etc/hostname instead of removing it.
#
# The list comes from /proc/self/mounts and nowhere else. An earlier version also
# hard-coded /proc /sys /dev /run, which was wrong about the last one: measured
# inside this base, /run is *not* a mount, is ordinary image content, and can be
# touched. Excluding it left one entry in the artifact carrying a wall-clock
# mtime — 987 seconds past the epoch — which changes the layer digest and
# differs between two builds. The mounts file already names the three paths
# under /run that really are mounts (/run/.containerenv, /run/secrets and
# systemd's stub resolv.conf), so nothing is gained by guessing at the parent.
#
# `-xdev` already stops the walk descending into another filesystem; what it does
# not do is stop `find` reporting the mount point directory itself.
RUN bash -euo pipefail -c '\
    epoch="${SOURCE_DATE_EPOCH}"; \
    mapfile -t mounts < <(awk "\$2 != \"/\" { print \$2 }" /proc/self/mounts | sort -u); \
    prune=(); \
    for point in "${mounts[@]}"; do \
      prune+=(-path "${point}" -o); \
    done; \
    unset "prune[${#prune[@]}-1]"; \
    mapfile -t unpinned < <(find / -xdev \( "${prune[@]}" \) -prune -o -newermt "@${epoch}" -print); \
    if [ ${#unpinned[@]} -gt 0 ]; then \
      printf "%s\0" "${unpinned[@]}" | xargs -0r touch --no-dereference --date="@${epoch}"; \
    fi; \
    mapfile -t remaining < <(find / -xdev \( "${prune[@]}" \) -prune -o -newermt "@${epoch}" -print); \
    if [ ${#remaining[@]} -gt 0 ]; then \
      echo "BLOCKED: these paths still carry an mtime later than the build epoch:" >&2; \
      printf "  %s\n" "${remaining[@]:0:20}" >&2; \
      echo "A file the build wrote and did not pin changes the layer digest, and the" >&2; \
      echo "comparison would report an archive difference with no file to attribute it to." >&2; \
      exit 2; \
    fi; \
    echo "pinned ${#unpinned[@]} path(s) written by this build to ${epoch}"'
