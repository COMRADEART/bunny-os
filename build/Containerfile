# syntax=docker/dockerfile:1
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44
FROM ${BASE_IMAGE}

ARG BUNNY_PROFILE=developer
ARG BUNNY_OS_VERSION=0.1.0
ARG BUNNY_IMAGE_VERSION=0.1.0-dev
ARG BUNNY_SOURCE_COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0
ARG BASE_IMAGE
ARG BUNNY_RELEASE_BUILD=0

LABEL org.opencontainers.image.title="Bunny OS" \
      org.opencontainers.image.version="${BUNNY_OS_VERSION}" \
      org.opencontainers.image.revision="${BUNNY_SOURCE_COMMIT}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      art.comrade.bunny-os.contract="1.0.0" \
      containers.bootc="1"

COPY build /tmp/bunny-os/build
COPY config /tmp/bunny-os/config
COPY desktop-integration /tmp/bunny-os/desktop-integration
COPY docs /tmp/bunny-os/docs
COPY installer /tmp/bunny-os/installer
COPY ARCHITECTURE.md README.md /tmp/bunny-os/
COPY schemas /tmp/bunny-os/schemas
COPY scripts /tmp/bunny-os/scripts
COPY selinux /tmp/bunny-os/selinux
COPY services /tmp/bunny-os/services
COPY shell /tmp/bunny-os/shell
COPY systemd /tmp/bunny-os/systemd
COPY tools /tmp/bunny-os/tools

# A hermetic build installs from the retained snapshot bind-mounted at
# /snapshot and stamps the transaction with the declared epoch through the
# bind-mounted libfaketime. Both are `podman build --volume` mounts: they exist
# for the RUN step and nothing they carry ends up in the image.
ARG BUNNY_SNAPSHOT_ROOT=
ARG BUNNY_FAKETIME_LIBRARY=

RUN BUNNY_SNAPSHOT_ROOT="${BUNNY_SNAPSHOT_ROOT}" \
    BUNNY_FAKETIME_LIBRARY="${BUNNY_FAKETIME_LIBRARY}" \
    SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH}" \
    /usr/bin/python3 /tmp/bunny-os/build/scripts/install-packages.py \
      --profile "${BUNNY_PROFILE}" \
      --release-build "${BUNNY_RELEASE_BUILD}" \
      --root /tmp/bunny-os/build/packages && \
    /usr/bin/python3 /tmp/bunny-os/build/scripts/install-root.py \
      --source /tmp/bunny-os \
      --profile "${BUNNY_PROFILE}" \
      --os-version "${BUNNY_OS_VERSION}" \
      --image-version "${BUNNY_IMAGE_VERSION}" \
      --source-commit "${BUNNY_SOURCE_COMMIT}" \
      --source-date-epoch "${SOURCE_DATE_EPOCH}" \
      --base-image "${BASE_IMAGE}" && \
    /usr/bin/dnf clean all && \
    /usr/bin/bash /tmp/bunny-os/build/scripts/finalise-image.sh \
      --epoch "${SOURCE_DATE_EPOCH}" \
      --report /usr/share/bunny-os/finalisation.json && \
    rm -rf /var/cache/dnf /tmp/bunny-os

# Pin every mtime the build itself wrote, as the last thing that happens.
#
# It has to be a separate step and it has to be last, because the step above
# ends by deleting /tmp/bunny-os and that deletion updates /tmp's own mtime
# after finalisation has already run. Measured on two hermetic builds:
# usr/share/bunny-os/finalisation.json had identical content and mtimes of
# 1785439457 and 1785439660 — wall clock, 203 seconds apart. The dimension
# collector does not compare mtimes, so nothing reported it; the layer tar
# contains them, so ociLayers and rawArchive differed and the difference was
# attributed entirely to the two databases.
#
# `-newermt` selects exactly what this build wrote: anything RPM installed
# carries the mtime from its package, which is earlier than the epoch and is
# packaging information rather than build noise, so it is left alone. The
# assertion afterwards is what makes this a check rather than a sweep — if a
# path cannot be pinned, the build stops instead of shipping an artifact whose
# archive digest nobody can explain.
RUN set -eu; \
    epoch="${SOURCE_DATE_EPOCH}"; \
    find / -xdev \
         \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o \
         -newermt "@${epoch}" -print0 \
      | xargs -0r touch --no-dereference --date="@${epoch}"; \
    remaining="$(find / -xdev \
         \( -path /proc -o -path /sys -o -path /dev -o -path /run \) -prune -o \
         -newermt "@${epoch}" -print | head -20)"; \
    if [ -n "${remaining}" ]; then \
      echo "BLOCKED: these paths still carry an mtime later than the build epoch:" >&2; \
      echo "${remaining}" >&2; \
      echo "A file the build wrote and did not pin changes the layer digest, and the" >&2; \
      echo "comparison would report an archive difference with no file to attribute it to." >&2; \
      exit 2; \
    fi
