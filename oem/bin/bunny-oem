#!/usr/bin/python3
"""Entry point for the bunny-oem command."""

from pathlib import Path
import sys

installed = Path("/usr/lib/bunny-oem")
sys.path.insert(0, str(installed if installed.is_dir() else Path(__file__).resolve().parents[2]))

from oem.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
