# Claude Code machine-local settings
.claude/settings.local.json

# Scratch: Mermaid render workspace and npm cache used by docs/phase-1/verify checks
.tmp/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Bunny OS generated validation/build outputs
build/out/
build/visual/
build/visual-v2/
build/visual-v3/

# Cargo build output for the experimental V3 compositor. Reproducible from the
# sources and Cargo.lock; hundreds of megabytes.
compositor/bunny-shell/target/
.selfcheck-tmp/
__pycache__/
*.py[cod]

# Scenario working disks: a booted copy of an installation artifact, kept
# only so the offline collectors can read it. Gigabytes each, reproducible
# from the pinned artifact and the installation record that made them, and
# never evidence in themselves — the record.json beside them is.
qualification/installed-system/evidence/*/work/

# TPM experiment working state: per-run disk overlays live in work/ and are
# deleted after digest capture; the retained OVMF variable store and swtpm
# state directory live in state/ so a later experiment can deliberately
# reuse them. Both are writable state, recorded by digest in the run's
# record.json and work-manifest.json, and never evidence in themselves.
qualification/tpm/evidence/*/work/
qualification/tpm/evidence/*/state/

# Per-run compositor logs and diagnostics from the V3 measurement harnesses.
# Each is a verbose backend trace tied to one run of one harness; the evidence
# that matters is the JSON report the harness distils from them.
visual-v3/reports/*.log
visual-v3/reports/*-diagnostics.json
