#!/usr/bin/env python3
"""The Bunny lock screen.

BUNNY WAYLAND SHELL EXPERIMENT - NOT RELEASE QUALIFIED - DO NOT USE AS THE
DEFAULT SESSION.

Uses ext-session-lock-v1 through gtk4-session-lock rather than a layer surface.
A layer surface can be covered by another layer surface; a lock surface cannot,
and the compositor treats it as the only thing that may be presented.

This client fails closed. If the lock cannot be established it exits non-zero
without ever having hidden anything, so the caller knows the session is not
locked instead of believing it is.
"""

from __future__ import annotations

import os
from pathlib import Path
import sys

source = Path(__file__).resolve().parents[2] / "apps/common"
installed = Path("/usr/lib/bunny-shell-v3")
sys.path.insert(0, str(source if source.is_dir() else installed))

from bunny_shell_v3 import NOTICE_LINES
from bunny_shell_v3.component_main import ensure_layer_shell_preloaded
from bunny_shell_v3.lock import AuthenticationHelper, AuthResult, LockScreenPolicy


def build_lock_surface(Gtk, policy: LockScreenPolicy, helper: AuthenticationHelper, on_unlock):
    import datetime

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    root.set_valign(Gtk.Align.CENTER)
    root.set_halign(Gtk.Align.CENTER)

    notice = Gtk.Label(label=" · ".join(NOTICE_LINES))
    notice.add_css_class("bunny-notice")
    root.append(notice)

    clock = Gtk.Label(label=datetime.datetime.now().strftime("%H:%M"))
    clock.update_property([Gtk.AccessibleProperty.LABEL], ["Current time"])
    root.append(clock)

    # No guide character on an authentication surface, in any mode.
    assert not policy.may_show_character()

    entry = Gtk.PasswordEntry()
    entry.set_show_peek_icon(True)
    entry.set_size_request(320, -1)
    entry.update_property([Gtk.AccessibleProperty.LABEL], ["Password"])
    root.append(entry)

    message = Gtk.Label(label="")
    message.update_property([Gtk.AccessibleProperty.LIVE], [Gtk.AccessibleLive.POLITE])
    root.append(message)

    def attempt(_widget):
        secret = entry.get_text()
        entry.set_text("")
        result = helper.authenticate(os.environ.get("USER", ""), secret)
        # The secret is not retained here either.
        del secret
        if result is AuthResult.SUCCESS:
            on_unlock()
            return
        if result is AuthResult.HELPER_UNAVAILABLE:
            message.set_text(
                "The authentication helper is not connected in the experimental shell. "
                "This session cannot be unlocked here."
            )
        else:
            message.set_text("Incorrect password.")

    entry.connect("activate", attempt)

    layouts = Gtk.Label(label=f"Keyboard: {os.environ.get('XKB_DEFAULT_LAYOUT', 'us')}")
    root.append(layouts)

    accessibility = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    for control in policy.accessibility_controls:
        button = Gtk.Button(label=control.replace("-", " ").title())
        button.update_property([Gtk.AccessibleProperty.LABEL], [control.replace("-", " ")])
        accessibility.append(button)
    root.append(accessibility)

    power = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    for action in policy.power_actions:
        button = Gtk.Button(label=action.replace("-", " ").title())
        button.update_property([Gtk.AccessibleProperty.LABEL], [action.replace("-", " ")])
        power.append(button)
    root.append(power)

    if not policy.may_show_notification_content(unlocked=False):
        hidden = Gtk.Label(label="Notifications are hidden while locked")
        hidden.add_css_class("bunny-unavailable")
        root.append(hidden)

    return root


def main() -> int:
    for line in NOTICE_LINES:
        print(line, file=sys.stderr)

    if os.environ.get("BUNNY_SHELL_EXPERIMENTAL") != "1":
        print("bunny-lock-screen: refusing to start: set BUNNY_SHELL_EXPERIMENTAL=1", file=sys.stderr)
        return 2
    if not os.environ.get("WAYLAND_DISPLAY"):
        print("bunny-lock-screen: requires a Wayland session", file=sys.stderr)
        return 2

    ensure_layer_shell_preloaded()

    try:
        import gi

        gi.require_version("Gtk", "4.0")
        gi.require_version("Gtk4SessionLock", "1.0")
        from gi.repository import Gdk, Gtk, Gtk4SessionLock
    except (ImportError, ValueError) as error:
        print(f"bunny-lock-screen: gtk4-session-lock is required: {error}", file=sys.stderr)
        return 2

    if "--describe" in sys.argv:
        print(
            '{"component": "lock-screen", "mechanism": "ext-session-lock-v1", '
            '"characterPermitted": false, "failsClosed": true}'
        )
        return 0

    policy = LockScreenPolicy()
    helper = AuthenticationHelper(service=os.environ.get("BUNNY_SHELL_PAM_SERVICE"))
    application = Gtk.Application(application_id="org.bunnyos.shell.v3.lockscreen")
    state = {"lock": None, "failed": False}

    def activate(app):
        lock = Gtk4SessionLock.prepare_lock()
        state["lock"] = lock

        def on_locked(_lock):
            print("bunny-lock-screen: session locked", file=sys.stderr)

        def on_failed(_lock):
            # Fail closed: report failure rather than leaving a window that
            # looks like a lock screen but is not one.
            state["failed"] = True
            print("bunny-lock-screen: LOCK FAILED; the session is NOT locked", file=sys.stderr)
            app.quit()

        lock.connect("locked", on_locked)
        lock.connect("failed", on_failed)

        if not lock.lock():
            state["failed"] = True
            app.quit()
            return

        def unlock():
            lock.unlock()
            app.quit()

        display = Gdk.Display.get_default()
        monitors = display.get_monitors()
        # A lock surface on every output. An output with no surface is an
        # uncovered area, which is the defect this loop exists to avoid.
        for index in range(monitors.get_n_items()):
            monitor = monitors.get_item(index)
            window = Gtk.Window(application=app)
            window.set_child(build_lock_surface(Gtk, policy, helper, unlock))
            lock.new_surface(window, monitor)
            window.present()
        print(f"bunny-lock-screen: covered {monitors.get_n_items()} output(s)", file=sys.stderr)

    application.connect("activate", activate)
    result = application.run([])
    return 3 if state["failed"] else result


if __name__ == "__main__":
    raise SystemExit(main())
