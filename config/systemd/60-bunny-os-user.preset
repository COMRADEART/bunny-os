enable bunny-config-dir.service
enable bunny-first-boot.service
enable bunny-first-run.service
disable bunny-desktop.service
disable bunny-shell.target
# GNOME Software refreshes its metadata from the moment the session starts, and
# the `download-updates=false` dconf key does not stop it: that key governs
# downloading *updates*, and the connection measured on the first booted Alpha
# image was the metadata refresh. Disabling the unit stops the background
# process; opening the application still works, and then it does what the person
# who opened it asked for.
disable gnome-software.service
# The companion runtime starts with the graphical session and outlives every
# window in it. Enabled rather than left to the desktop entry: the entry opens a
# *client*, and a client that had to start the runtime would mean closing the
# last window stopped whatever it was doing.
enable bunny-companion.service
# The window is deliberately *not* enabled, and the history is worth keeping
# because it reversed twice for good reasons both times.
#
# It was enabled on the Public Alpha branch because nothing started it: a fresh
# machine ran a companion that was invisible and the only way to see it was
# `bunny-os companion shell` in a terminal. That was a real problem and this was
# the right fix for it *at the time* — the desktop had no assistant surface of
# its own.
#
# It has one now. The shell renders the character, the speech bubble and the
# assistant input, and starting the GTK window at login put a second, larger
# representation of the same assistant on top of the first one. The screenshots
# in DESKTOP_SHELL_ALPHA_VALIDATION.md show it covering the character.
#
# So the runtime is enabled and the window is not. Opening it still works — the
# Applications grid, the dock tile, or `systemctl --user start
# bunny-companion-window.service` — and it is the right surface for the task
# list and the transcript. Nothing starts it for you.
disable bunny-companion-window.service
