# Qualification evidence is attested by sha256 digests recorded inside the
# evidence trees. Any content filter (EOL normalization included) silently
# breaks the attestation on checkout, so evidence bytes must round-trip git
# exactly.
qualification/** -text
build/out/** -text

# Image content. These files are copied verbatim into the image by
# build/scripts/install-root.py and are then parsed by systemd, systemd-tmpfiles
# and the shell, none of which treat a trailing CR as whitespace: a unit
# checked out with CRLF yields directive values ending in \r, and a tmpfiles
# line likewise. A Windows checkout under core.autocrlf=true produces exactly
# that, and the corruption would reach the image only when someone built from
# that working tree — silently, and nowhere near the checkout that caused it.
systemd/** -text
config/** -text
*.sh -text

# Visual Phase V3 (experimental Wayland shell). Session launchers, systemd
# units and desktop entries here are parsed by the same CR-intolerant tooling as
# the image content above, and the Rust sources are compiled on Linux. The V3
# evidence files record sha256 digests of their own bytes, so they must round
# trip git exactly for the same reason the qualification evidence must.
compositor/** text=auto eol=lf
shell-ui/** text=auto eol=lf
portals/** text=auto eol=lf
sessions/** text=auto eol=lf
visual-v3/tools/** text=auto eol=lf
visual-v3/reports/** -text

# V4 framework-closure evidence. The environment probe output is the evidence
# behind every NOT_AVAILABLE gate, and a checkout that rewrites its line endings
# rewrites evidence. Same reasoning as qualification/ above.
visual-v4/evidence/** -text
visual-v4/contract/** -text
