{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.invalid/schemas/install-media-manifest.schema.json",
  "title": "Bunny OS installation media manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "imageVersion", "sourceCommit", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "imageVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "critical"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "critical": { "type": "boolean" }
        }
      }
    }
  }
}
