{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/offline-policy-bundle-1.schema.json",
  "title": "Bunny OS offline management bundle manifest",
  "description": "A signed bundle transported through removable media for air-gapped management. signatureVerified is const true: there is no unsigned or 'trusted local' import path, and being offline never lowers the trust requirement. A monotonic per-organisation sequence prevents stale policy replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "kind", "organisationId", "sequence", "createdAt", "expiresAt", "contentDigest", "signatureKeyId", "signatureVerified", "sizeBytes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "type": "string", "pattern": "^bnd-[0-9a-f]{16}$" },
    "kind": {
      "type": "string",
      "enum": ["policy-bundle", "update-export", "application-mirror", "enrolment-proxy-configuration", "offline-recovery-package", "status-report"]
    },
    "organisationId": { "type": "string", "pattern": "^org-[a-z0-9][a-z0-9-]{1,62}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signatureKeyId": {
      "type": "string",
      "pattern": "^fleet-[a-z0-9-]{2,48}$",
      "description": "Fleet-control signing keys are namespaced separately from OS update keys and OEM keys."
    },
    "signatureVerified": { "const": true },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 }
  }
}
