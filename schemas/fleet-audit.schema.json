{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/fleet-audit-1.schema.json",
  "title": "Bunny OS fleet audit entry",
  "description": "One tamper-evident administrative action record. Entries form a per-organisation hash chain: entryHash covers the canonical entry with entryHash removed, and previousHash links to the preceding entry, so modification or deletion is detectable. Entries never store secrets or user content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "organisationId", "administrator", "operation", "targetScope", "policyVersion", "occurredAt", "authorisation", "result", "correlationId", "previousHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly increasing within one organisation. A gap indicates a deleted entry."
    },
    "organisationId": { "type": "string", "pattern": "^org-[a-z0-9][a-z0-9-]{1,62}$" },
    "administrator": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
    "targetScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "policyVersion": { "type": ["integer", "null"], "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "authorisation": {
      "type": "string",
      "enum": ["local-administrator", "oidc", "saml", "passkey", "hardware-security-key", "recovery-code"]
    },
    "result": {
      "type": "string",
      "enum": ["succeeded", "failed", "refused", "partially-applied", "rolled-back"]
    },
    "failureCode": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rolledBack": { "type": "boolean" },
    "correlationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "previousHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
