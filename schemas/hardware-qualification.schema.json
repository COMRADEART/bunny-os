{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/hardware-qualification-1.schema.json",
  "title": "Bunny OS hardware qualification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reports"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "hardwareClass", "executions", "evidence", "openIssueSeverities", "explicitlyUnsupported", "expectedToWork"],
        "additionalProperties": false,
        "properties": {
          "model": { "type": "string", "maxLength": 256 },
          "hardwareClass": { "type": "string", "maxLength": 256 },
          "executions": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "openIssueSeverities": { "type": "array", "items": { "type": "string" } },
          "explicitlyUnsupported": { "type": "boolean" },
          "expectedToWork": { "type": "boolean" }
        }
      }
    }
  }
}
