{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunny-os.org/schemas/oem-qualification-1.schema.json",
  "title": "Bunny OS OEM hardware qualification report",
  "description": "A per-model OEM qualification run: a fixed test suite plus a sustained-load campaign, signed by the qualifying party. Distinct from hardware-qualification-1, which classifies community reports into support tiers. A report cannot pass without validated recovery, and a performance claim requires a declared methodology and at least two repeat runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model", "tests", "methodologyReference", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "vendor": { "type": "string", "maxLength": 256 },
    "profileId": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{1,62}[a-z0-9])$" },
    "repeatRuns": { "type": "integer", "minimum": 1 },
    "formalCertificationProcess": {
      "type": "boolean",
      "description": "Only a completed formal process, with repeat runs and no declared limitations, permits a certification claim."
    },
    "methodologyReference": { "type": "string", "minLength": 1, "maxLength": 512 },
    "recoveryValidated": { "type": "boolean" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required tests must PASS. Optional tests may be NOT_APPLICABLE when the hardware genuinely lacks the component, which becomes a declared limitation.",
      "properties": {
        "installation": { "$ref": "#/$defs/status" },
        "encryption": { "$ref": "#/$defs/status" },
        "secure-boot": { "$ref": "#/$defs/status" },
        "graphics": { "$ref": "#/$defs/status" },
        "display": { "$ref": "#/$defs/status" },
        "wifi": { "$ref": "#/$defs/status" },
        "audio": { "$ref": "#/$defs/status" },
        "suspend-resume": { "$ref": "#/$defs/status" },
        "storage": { "$ref": "#/$defs/status" },
        "updates": { "$ref": "#/$defs/status" },
        "rollback": { "$ref": "#/$defs/status" },
        "recovery": { "$ref": "#/$defs/status" },
        "multi-user": { "$ref": "#/$defs/status" },
        "tpm": { "$ref": "#/$defs/status" },
        "bluetooth": { "$ref": "#/$defs/status" },
        "camera": { "$ref": "#/$defs/status" },
        "battery": { "$ref": "#/$defs/status" },
        "thermals": { "$ref": "#/$defs/status" },
        "bunny-local-ai": { "$ref": "#/$defs/status" }
      }
    },
    "sustainedLoad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sustained-cpu": { "$ref": "#/$defs/loadScenario" },
        "sustained-gpu": { "$ref": "#/$defs/loadScenario" },
        "local-model-inference": { "$ref": "#/$defs/loadScenario" },
        "simultaneous-compile-and-model": { "$ref": "#/$defs/loadScenario" },
        "battery-operation": { "$ref": "#/$defs/loadScenario" },
        "charging": { "$ref": "#/$defs/loadScenario" },
        "suspend-cycles": { "$ref": "#/$defs/loadScenario" }
      }
    },
    "performanceClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "methodology", "repeatRuns"],
        "properties": {
          "claim": { "type": "string", "maxLength": 512 },
          "methodology": { "type": "string", "minLength": 32, "maxLength": 4096 },
          "repeatRuns": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "knownLimitations": { "type": "array", "items": { "type": "string", "maxLength": 512 } },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^oem-[a-z0-9-]{2,48}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/=]{64,}$" }
      }
    }
  },
  "$defs": {
    "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_RUN"] },
    "loadScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "An executed scenario must record every observation, including negative ones.",
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_RUN"] },
        "thermalThrottling": { "type": "string", "maxLength": 512 },
        "fanBehaviour": { "type": "string", "maxLength": 512 },
        "powerUse": { "type": "string", "maxLength": 512 },
        "crashes": { "type": "string", "maxLength": 512 },
        "dataCorruption": { "type": "string", "maxLength": 512 },
        "driverResets": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
